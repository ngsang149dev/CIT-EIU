classDiagram
    class RetailItem {
        - description: String
        - unitOnHand: int 
        - price: double

        + RetailItem(description: String, unitOnHand: int, price: double)
        + getter()
        + setter()
    }

    class CashRegister {
        - retailItem: RetailItem
        - quantity: int
        - TAX_RATE: double$
        + CashRegister(retailItem: RetailItem, quantity: int)
        + getSubtotal() double
        + getTax() double
        + getTotal() double

    }

    CashRegister --o RetailItem