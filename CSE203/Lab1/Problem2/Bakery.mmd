classDiagram
    class Customer {
        - name: String
        - address: String
        - phone: String
        + Customer()
        + getter()
        + setter()
        + receiveQuote(quote: Quote) void  
    }

    class Cake {
        - type: String
        - tiers: String
        - eventDate: LocalDate

        + Cake()
        + getter()
        + setter()
    }

    class Quote {
        - ingredientCost: double
        - laborCharge: double
        - deliveryFee: double
        - totalWithTax: double
        + Quote()
        + setter()
        + getter()
        + calculateTotal() double
    }

    class Const {
        <<constant>>
        + TAX() double
    }

    class Event {
        <<enumeration>>
        WEDDING
        BIRTHDAY
    }

    Customer --> Quote: receives
    Customer o-- Cake: orders
    Event --> Cake: uses
    Cake *-- Quote: has
    Quote --> Const: uses