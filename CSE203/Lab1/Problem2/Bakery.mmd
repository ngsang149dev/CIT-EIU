classDiagram
    class Customer {
        - name: String
        - address: String
        - phone: String
        + Customer()
        + getter()
        + setter()
        + receiveQuote(quote: Quote) void  
        + toString() String
    }

    class Cake {
        - type: String
        - tiers: int
        - eventDate: LocalDate

        + Cake()
        + getter()
        + setter()
        + toString() String
    }

    class Quote {
        - ingredientCost: double
        - laborCharge: double
        - deliveryFee: double
        + Quote()
        + setter()
        + getter()
        + calculateTotal() double
        + toString() String
    }

    class Const {
        <<constant>>
        +$TAX: double 
    }

    class Event {
        <<enumeration>>
        WEDDING
        BIRTHDAY
    }

    Customer --> Quote: receives
    Customer o-- Cake: orders
    Event --> Cake: uses
    Cake *-- Quote: has
    Quote --> Const: uses