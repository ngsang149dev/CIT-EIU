classDiagram
    class Customer {
        - name: String
        - address: String
        - phone: String
        + Customer()
        + getter()
        + setter()
    }

    class Cake {
        - typeOfCake: char
        - tier: int 
        - eventDate: String
        + Cake()
        + getter()
        + setter()
    }

    class PriceQuote {
        - ingredientCost: double
        - laborCharge: double
        - deliveryFee: double
        + PriceQuote()
        + setter()
        + getter()
        + getTotalAfterTax()
    }

    Customer --> Cake: orders
    Cake *-- PriceQuote: belongs to

