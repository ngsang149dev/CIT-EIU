classDiagram
    class Customer {
        - name: String
        - address: String
        - phone: String
        + Customer()
        + getter()
        + setter()
        + receiveBooking(booking: Booking) void
    }


    class Booking {
        - baseFee: double
        - editingCharge: double
        - date: Date
        - duration: int
        - totalWithTax: double
        + getTotalAfterTax()
        + Booking()
        + getter()
        + setter()
    }

    class Const {
        <<constant>>
        + TAX: double
    }

    class SessionType {
        <<enumeration>> 
        FAMILY
        WEDDING
        PORTRAIT
    }

    Customer --> Booking: orders
    Booking ..> SessionType: uses
    Booking ..> Const: uses