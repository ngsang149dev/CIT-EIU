classDiagram
    class Customer {
        - name: String
        - address: String
        - phone: String
        - id: String
        + Customer()
        + getter()
        + setter()
        + receiveEstimate(e: ServiceEstimate) void
    }

    class Pet {
        - breed: String
        - age: int 
        - weight: double
        + Pet() 
        + getter()
        + setter()  
    }

    class ServiceEstimate {
        - grommingCost: double
        - taxRate: double
        - additionalCareCharge: double
        + ServiceEstimate()
        + getter()
        + setter()
        + getTotalCostAfterTax() double
    }

    class PetShop {
        - shopName: String
        - address: String
        - phone: String
        + addCustomer(c: Customer)
    }

    Customer o-- Pet: owns
    Pet *-- ServiceEstimate: has
    PetShop o-- Customer: serves
    PetShop o-- Pet: services    


