classDiagram
    class Customer {
        - name: String
        - address: String
        - licenseNumber: String
        + Customer()
        + getter()
        + setter()
        + receiveAgreement(agreement: Agreement) void
        + toString() String
    }
    class Car {
        - model: String
        - make: String
        + Car()
        + getter()
        + setter()
        + toString() String
    }
    class Agreement {
        - mileageLimit: double
        - rentalPeriod: int
        - rentalFee: double
        - mileageFee: double
        + Agreement()
        + getTotalAfterTax() double
        + getter()
        + setter()
        + toString()
    }
    class Const {
        <<constant>> 
        + $TAX: double
    }

    Agreement o-- Car
    Customer ..> Agreement
    Customer o-- Car
    Agreement --> Const
    