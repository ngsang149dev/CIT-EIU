classDiagram 
    class User {
        - id: int 
        - name: String
        - email: String
        + User()
        + getter()
        + setter() 
        + toString() String
    }

    class Book {
        - isbn: String
        - title: String
        - isAvalable: boolean
        - author: String
        + Book()
        + getter()
        + setter()
        + toString() String
    }

    class BorrowingRecord {
        - borrowingDate: LocalDate
        - dueDate: LocalDate
        + BorrowingRecord()
        + getter()
        + setter()
        + isOverdue() boolean
        + toString() String
    }

    class LibraryManagement {
        - borrowingHistory: List <BorrowingRecord>
        + LibraryManagement()
        + addRecord(record: BorrowingRecord) void
        + checkEligibility(user: User): boolean
        + borrowBook(user: User, book: Book, days: int) BorrowingRecord
        + toString() String
    }

    BorrowingRecord *-- User: borrowingUser
    BorrowingRecord *-- Book: borrowedBook
    LibraryManagement o-- BorrowingRecord: creates
    LibraryManagement o-- User : verifies
    LibraryManagement o-- Book : checks
